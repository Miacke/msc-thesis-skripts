df[i, "parallel_3_4"] <- TRUE
} else{
df[i, "parallel_3_4"] <- FALSE
}
# prüfen welche zelle von linien 1/3 getroffen wurden
if(df[i, "line_1"] == TRUE | df[i, "line_3"] == TRUE){
df[i, "kreuz_1_3"] <- TRUE
} else{
df[i, "kreuz_1_3"] <- FALSE
}
# prüfen welche zelle von linien 2/4 getroffen wurden
if(df[i, "line_2"] == TRUE | df[i, "line_4"] == TRUE){
df[i, "kreuz_2_4"] <- TRUE
} else{
df[i, "kreuz_2_4"] <- FALSE
}
}
kreuz <- (sum(df[, "kreuz_1_3"]) + sum(df[, "kreuz_2_4"]))/2
parallel <- (sum(df[, "parallel_1_2"]) + sum(df[, "parallel_3_4"]))/2
durchschn_kreuz <- c(durchschn_kreuz, kreuz)
durchschn_parallel <- c(durchschn_parallel, parallel)
diff <- c(diff, kreuz-parallel)
}
mean(durchschn_kreuz)
mean(durchschn_parallel)
mean(diff)
gc()
